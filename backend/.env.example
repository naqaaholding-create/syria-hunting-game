# Copy to .env locally. NEVER commit the real .env file.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use a managed secret store in production; never place private keys in GitHub.
TRON_NETWORK=shasta
TRON_API_BASE_URL=https://api.shasta.trongrid.io
TRONGRID_API_KEY=
# Public receiving address only; must be created/verified separately.
TRON_DEPOSIT_ADDRESS=
# Keep disabled until auth, deposit attribution, confirmations and monitoring are implemented.
ENABLE_DEPOSITS=false
ENABLE_WITHDRAWALS=false
